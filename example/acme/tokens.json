{
  "$schema": "https://raw.githubusercontent.com/DAYOU-INC/brand-kit/main/schemas/tokens.schema.json",
  "$description": "Acme（虚构示例品牌）设计令牌。格式：DTCG 2025.10；扩展字段见 brand-kit docs/令牌规范.md。",
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1216,
            0.3059,
            0.3725
          ],
          "hex": "#1f4e5f"
        },
        "$description": "主色（深青）。大面积底色、标题、按钮。白字在上 9.08:1。",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "confirmed",
            "channels": [
              "web",
              "app",
              "marketing",
              "print"
            ],
            "source": "示例：VI 手册第 2 页色块取色",
            "confirmedBy": "示例：品牌负责人，设计评审会",
            "confirmedAt": "2026-11-01",
            "print": {
              "cmyk": "85 50 40 30",
              "pantone": "示例：待打样后填写"
            }
          }
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.7843,
            0.3804,
            0.1176
          ],
          "hex": "#c8611e"
        },
        "$description": "强调色（焦糖橙）。价格、关键数字、小面积强调。白字在上 4.05:1，只用于大字。",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "current",
            "channels": [
              "web",
              "app",
              "marketing",
              "print"
            ],
            "source": "示例：产品渲染图旋钮取色（众数）"
          }
        }
      },
      "accent-light": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.949,
            0.7059,
            0.5412
          ],
          "hex": "#f2b48a"
        },
        "$description": "浅焦糖。背景块、渐变终点。上面只放 color.brand.ink 文字，不放白字（1.80:1）。",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "current",
            "channels": [
              "web",
              "marketing"
            ],
            "source": "示例：详情页背景块取色"
          }
        }
      },
      "cream": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.9569,
            0.9294,
            0.8941
          ],
          "hex": "#f4ede4"
        },
        "$description": "奶油色。浅色页面底色、卡片底色。",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "current",
            "channels": [
              "web",
              "app",
              "marketing",
              "print"
            ],
            "source": "示例：详情页底色取色"
          }
        }
      },
      "ink": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0784,
            0.0941,
            0.1098
          ],
          "hex": "#14181c"
        },
        "$description": "深色文字和深色底。",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "current",
            "channels": [
              "web",
              "app",
              "marketing",
              "print"
            ],
            "source": "示例：详情页正文取色"
          }
        }
      }
    },
    "neutral": {
      "white": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "hex": "#ffffff"
        },
        "$description": "白色。",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "current",
            "channels": [
              "web",
              "app",
              "marketing",
              "print"
            ],
            "source": "通用值"
          }
        }
      }
    },
    "digital": {
      "web-primary": {
        "$value": "{color.brand.primary}",
        "$description": "网站主色，指向品牌主色。",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "current",
            "channels": [
              "web",
              "app"
            ],
            "source": "示例：网站样式表"
          }
        }
      }
    },
    "device": {
      "ready": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2471,
            0.6392,
            0.302
          ],
          "hex": "#3fa34d"
        },
        "$description": "磨豆机屏幕“可以开始”的指示绿。只用于设备屏幕和屏幕模拟图，不进网站和广告。",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "current",
            "channels": [
              "device"
            ],
            "source": "示例：设备 UI 设计稿取色"
          }
        }
      }
    },
    "legacy": {
      "orange": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            0.4784,
            0
          ],
          "hex": "#ff7a00"
        },
        "$description": "旧版强调色，已被 color.brand.accent 取代。只为记录，不导出。",
        "$deprecated": "改用 color.brand.accent",
        "$extensions": {
          "com.github.dayou-inc.brand-kit": {
            "status": "current",
            "channels": [],
            "source": "示例：2024 年旧版详情页"
          }
        }
      }
    }
  },
  "gradient": {
    "$type": "gradient",
    "warm": {
      "$value": [
        {
          "color": "{color.brand.cream}",
          "position": 0
        },
        {
          "color": "{color.brand.accent-light}",
          "position": 1
        }
      ],
      "$description": "暖色横向渐变，从奶油到浅焦糖。用于横幅背景。",
      "$extensions": {
        "com.github.dayou-inc.brand-kit": {
          "status": "current",
          "channels": [
            "web",
            "marketing"
          ],
          "source": "示例：首页横幅",
          "angle": 90
        }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Source Sans 3",
        "sans-serif"
      ],
      "$description": "标题和正文字体（拉丁）。",
      "$extensions": {
        "com.github.dayou-inc.brand-kit": {
          "status": "current",
          "channels": [
            "web",
            "app",
            "marketing"
          ],
          "source": "示例：详情页 PSD 文字图层；Google Fonts，SIL OFL 1.1"
        }
      }
    },
    "body": {
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ],
      "$description": "网页正文用系统字体栈。",
      "$extensions": {
        "com.github.dayou-inc.brand-kit": {
          "status": "current",
          "channels": [
            "web"
          ],
          "source": "示例：网站样式表"
        }
      }
    },
    "packaging-cn": {
      "$value": [
        "Source Han Sans SC"
      ],
      "$description": "包装中文字体（思源黑体）。",
      "$extensions": {
        "com.github.dayou-inc.brand-kit": {
          "status": "pending",
          "channels": [
            "print"
          ],
          "source": "示例：包装稿",
          "pendingReason": "包装供应商要求的字体文件格式还没确认"
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "card": {
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$description": "网站和 App 卡片圆角。",
      "$extensions": {
        "com.github.dayou-inc.brand-kit": {
          "status": "current",
          "channels": [
            "web",
            "app"
          ],
          "source": "示例：网站样式表"
        }
      }
    },
    "card-marketing": {
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "营销长图卡片圆角。",
      "$extensions": {
        "com.github.dayou-inc.brand-kit": {
          "status": "current",
          "channels": [
            "marketing"
          ],
          "source": "示例：详情页实测"
        }
      }
    }
  }
}
