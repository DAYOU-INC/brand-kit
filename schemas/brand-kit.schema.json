{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DAYOU-INC/brand-kit/v0.3.4/schemas/brand-kit.schema.json",
  "title": "brand-kit 品牌库配置",
  "type": "object",
  "required": [
    "brands"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "brands": {
      "description": "本库的品牌目录名列表",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
        "not": {
          "enum": [
            "build",
            "node_modules",
            "templates",
            "docs",
            "scripts",
            "schemas",
            "src",
            "test",
            "tests",
            "assets",
            "examples",
            "example"
          ]
        }
      }
    }
  }
}
