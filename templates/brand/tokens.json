{
  "$schema": "https://raw.githubusercontent.com/DAYOU-INC/brand-kit/main/schemas/tokens.schema.json",
  "$description": "<品牌> 设计令牌。格式：DTCG 2025.10；扩展字段见 brand-kit docs/令牌规范.md。",
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" },
        "$description": "<主色：用在哪里、注意什么>",
        "$extensions": { "com.github.dayou-inc.brand-kit": { "status": "current", "channels": ["web", "app", "marketing", "print"], "source": "<素材路径和取色方法>" } }
      }
    },
    "neutral": {
      "white": {
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" },
        "$description": "白色。",
        "$extensions": { "com.github.dayou-inc.brand-kit": { "status": "current", "channels": ["web", "app", "marketing", "print"], "source": "通用值" } }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["<字体>", "sans-serif"],
      "$description": "<标题字体：用途、授权>",
      "$extensions": { "com.github.dayou-inc.brand-kit": { "status": "current", "channels": ["web", "app", "marketing"], "source": "<出处>" } }
    }
  },
  "radius": {
    "$type": "dimension",
    "card": {
      "$value": { "value": 12, "unit": "px" },
      "$description": "<卡片圆角>",
      "$extensions": { "com.github.dayou-inc.brand-kit": { "status": "current", "channels": ["web", "app"], "source": "<出处>" } }
    }
  }
}
